# .env.example — คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:  cp .env.example .env
#
# อย่า commit ไฟล์ .env ที่มีค่าจริงขึ้น git เด็ดขาด — .env ถูก ignore ไว้ใน
# .gitignore แล้ว ไฟล์นี้ (.env.example) เก็บเฉพาะ 'ชื่อคีย์ + ค่าตัวอย่าง'
# ไม่มีความลับจริง จึง commit ได้ปลอดภัย
#
# DO NOT commit a real .env. Only this example (placeholders, no secrets)
# is tracked. If a real BOT_TOKEN/API key was ever committed, rotate it.

# ---------------- Required ----------------
BOT_TOKEN=YOUR_BOT_TOKEN

# gemini.py reads GPT_API_KEY / GPT_MODEL, NOT GEMINI_API_KEY / GEMINI_MODEL.
# The committed .env set the GEMINI_* names, so every AI path logged
# "GPT_API_KEY is not set" and bailed: /imagine, mention replies, the spam
# classifier and news AI summaries were all silently inactive.
GPT_API_KEY=YOUR_GEMINI_API_KEY

# ---------------- AI (optional; defaults in gemini.py) ----------------
GPT_MODEL=gpt-5.6-luna
GPT_IMAGE_MODEL=
GEMINI_CLASSIFIER_MODEL=

# ---------------- Quotas (optional; 0 = unlimited) ----------------
AI_MEMBER_DAILY_LIMIT=10
AI_ADMIN_DAILY_LIMIT=0
AI_CLASSIFIER_DAILY_LIMIT=10
AI_CLASSIFIER_CONFIDENCE_THRESHOLD=0.5

# ---------------- News (optional) ----------------
NEWS_HTTP_TIMEOUT=15
# ส่งข่าวไม่ถี่เกินไป: รอบเช็คห่างขึ้น (วินาที) + ข่าวต่อรอบต่อแหล่งน้อยลง +
# เว้นจังหวะระหว่างข่าวแต่ละชิ้น (วินาที) กันข้อความมาเป็นชุดรัวๆ
NEWS_CHECK_INTERVAL=900
NEWS_MAX_ITEMS_PER_CYCLE=3
NEWS_SEND_DELAY_SECONDS=3
NEWS_SEND_BACKLOG_ON_FIRST_RUN=true
# ให้ AI เห็นเนื้อบทความมาก (ARTICLE) แต่สรุปสั้นลง เน้นเนื้อหา (SUMMARY)
# บทความยาวจะไม่ถูกปฏิเสธเพราะ news ส่งด้วยเพดาน input แบบงานวิจัย (RESEARCH_MAX_INPUT_CHARS)
NEWS_AI_SUMMARY_MAX_CHARS=800
NEWS_ARTICLE_MAX_CHARS=5000
NEWS_RSS_SUMMARY_MIN_CHARS=600
NEWS_DISCUSSION_DOMAINS=news.ycombinator.com

# ปลายทางเริ่มต้นของทุกแหล่งข่าว — ตั้งครั้งเดียว แหล่งใดไม่ระบุ chat/topic เฉพาะ
# จะส่งเข้าห้อง/หัวข้อนี้ (แหล่งที่ไม่มี chat_id ทั้งเฉพาะและ default จะถูกข้าม)
NEWS_CHAT_ID_DEFAULT=-1004382747769
NEWS_TOPIC_ID_DEFAULT=72

# Reader proxy — ทางออกสำหรับเว็บที่กันบอท (Cloudflare/challenge/JS-only/soft paywall)
# เมื่อดึง HTML ตรง ๆ แล้วเนื้อหาใช้ไม่ได้ บอตจะดึงผ่าน reader นี้แทน (ฟรี ไม่ต้องใช้คีย์)
# ปิดด้วย false หรือเปลี่ยน endpoint ที่ NEWS_READER_PROXY (ต้องลงท้ายด้วย /)
NEWS_READER_FALLBACK=true
NEWS_READER_PROXY=https://r.jina.ai/
NEWS_READER_TIMEOUT=25

# แหล่งข่าวมี RSS/Atom feed เริ่มต้นในโค้ดอยู่แล้ว (news.py: NEWS_SOURCES) — ไม่ต้องตั้ง
# feed เองก็ทำงานได้ ด้านล่างไว้ override หรือกำหนดปลายทาง/หัวข้อเฉพาะแหล่ง
# รูปแบบตัวแปร: NEWS_FEED_URL_<NAME> / NEWS_PAGE_URL_<NAME> / NEWS_CHAT_ID_<NAME> /
#              NEWS_TOPIC_ID_<NAME> / NEWS_AI_SUMMARY_<NAME> / NEWS_MAX_ITEMS_<NAME>
# แหล่งที่มีให้: hackernews, krebsonsecurity, thehackernews, bleepingcomputer,
#              darkreading, theregister, securityweek, schneier, therecord, cisa,
#              arstechnica, blognone (ข่าวไทย)
NEWS_PAGE_URL_HACKERNEWS=https://news.ycombinator.com/
NEWS_FEED_URL_HACKERNEWS=https://news.ycombinator.com/rss
NEWS_FEED_URL_KREBSONSECURITY=https://krebsonsecurity.com/feed/

# ---------------- Tor (optional; used by search.py / scrape.py) ----------------
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_GATEWAY_SUFFIXES=.ly,.ps,.cab,.direct

# บอตจะสตาร์ท Tor เองตอนบูต (tor_launcher.py) — สำคัญบนโฮสต์ที่รัน `python app.py`
# ตรง ๆ ไม่ผ่าน docker-entrypoint.sh เช่น FPS.ms / แพเนล Pterodactyl
# ลำดับ: Tor ที่ต่อได้อยู่แล้ว -> tor binary ในเครื่อง -> ดาวน์โหลด Tor Expert Bundle
TOR_AUTO_DOWNLOAD=1            # 1=อนุญาตให้บอตดาวน์โหลด Tor เองเมื่อไม่มี binary
# TOR_BINARY=/home/container/tor   # อัปโหลด tor เองแล้วชี้มาที่นี่ (ไม่ต้องดาวน์โหลด)
# TOR_EXPERT_VERSION=13.5.7        # เวอร์ชัน Tor Expert Bundle ที่จะดาวน์โหลด
# TOR_DOWNLOAD_URL=                # ระบุ URL tarball เต็มเอง (override เวอร์ชัน/สถาปัตยกรรม)
# TOR_DATA_DIR=/tmp/tor-data       # โฟลเดอร์ข้อมูล Tor (ต้องเขียนได้)
TOR_BOOTSTRAP_TIMEOUT=30      # วินาทีที่รอให้พอร์ต SOCKS เปิดตอนบูต
# DISABLE_TOR=1                # ปิดการจัดการ Tor ทั้งหมด (ค้นเฉพาะเว็บเปิด)

SEARCH_TOTAL_BUDGET_SECONDS=45
SEARCH_USE_TOR=auto
SEARCH_MAX_RESULTS=40

SCRAPE_TOTAL_BUDGET_SECONDS=60
SCRAPE_USE_TOR=auto
SCRAPE_MAX_URLS=20

# ---------------- OSINT: ค้น dark web (onion) ----------------
# ความยาวคำโปรย (snippet) ต่อผลลัพธ์ที่เก็บจากหน้าเอนจิน ใช้ช่วยจัดอันดับ
# และเป็นข้อมูลสำรองเมื่อ scrape เนื้อหาจริงไม่สำเร็จ
SEARCH_MAX_SNIPPET_CHARS=300

# ---------------- OSINT: ค้นเว็บเปิด (clearnet) ----------------
# ข้อมูลตัวตนบุคคลอยู่บนเว็บเปิดเป็นหลัก ไม่ใช่ dark web
SEARCH_CLEARNET_ENABLED=true
# ปิด engine เป็นรายตัวได้ เช่น Bing,Brave (คั่นด้วยคอมมา ว่าง = เปิดหมด)
SEARCH_CLEARNET_DISABLED=
OSINT_INCLUDE_CLEARNET=true
OSINT_INCLUDE_DARKWEB=true

# ---------------- OSINT: ค้นบัญชีผู้ใช้ข้ามเว็บ ----------------
# ใช้ฐานข้อมูลเว็บของโปรเจกต์เอง (resource/data.json — ใช้ตรวจได้ 2,449 เว็บ)
USERNAME_ENUM_ENABLED=true
OSINT_USERNAME_ENUM=true
# ตรวจกี่เว็บต่อหนึ่งชื่อบัญชี (เรียงเว็บสำคัญไว้ก่อน)
USERNAME_MAX_SITES=60
USERNAME_BUDGET_SECONDS=30
# เอาชื่อบัญชีที่เจอในรอบแรกไปค้นต่อได้กี่ชื่อ
OSINT_USERNAME_MAX_HANDLES=2

# ---------------- OSINT: ค้นรอบสอง (pivot) ----------------
# เอาอีเมล/โปรไฟล์/เบอร์ที่เจอในรอบแรกไปค้นต่อ
OSINT_PIVOT_ENABLED=true
OSINT_PIVOT_QUERIES=3

# ---------------- OSINT: เพดานเวลาและปริมาณ ----------------
OSINT_TOTAL_BUDGET_SECONDS=100
OSINT_MAX_QUERIES=3
OSINT_MAX_SOURCES=12
OSINT_SCRAPE_FIRST_BATCH=6
# เพดานตัวอักษรของหลักฐานที่ส่งให้ AI (เพดานแชทปกติคือ 4000)
RESEARCH_MAX_INPUT_CHARS=24000

# ---------------- Coordinator (optional) ----------------
COORDINATOR_MAX_WORKERS=3

# ---------------- Repository test sandbox (optional; off by default) ----------------
REPO_TEST_EXECUTION_ENABLED=
REPO_TEST_TIMEOUT_SECONDS=
REPO_TEST_MEMORY_LIMIT_BYTES=
REPO_TEST_MAX_PROCESSES=
REPO_TEST_MAX_OUTPUT_BYTES=
REPO_MAX_CONCURRENT_TEST_RUNS=

# ---------------- Blockchain anchoring (optional) ----------------
CHAIN_ENABLED=true
CHAIN_BINARY=/path/to/sombra-chain
CHAIN_TIMEOUT=30
CHAIN_ANCHOR_INTERVAL=300
CHAIN_MAX_TX_PER_BLOCK=500
CHAIN_STARTUP_DELAY=